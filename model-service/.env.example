MODEL_SERVICE_PORT=8000

# Ruta al checkpoint de YOLOv8 ya entrenado. Copia best.pt (o last.pt) dentro
# de model-service/weights/ y ajusta esta ruta si usas otro nombre de fichero.
MODEL_WEIGHTS_PATH=./weights/best.pt
# Pixeles (cuadrado) que se piden al WMS de PNOA por tile. PNOA nativo es
# ~0.25-0.50 m/px; pedir mas pixeles que eso para una zona concreta no
# inventa detalle real (el WMS solo interpola), asi que el zoom del grid de
# analisis (frontend, MAX_TILE_ZOOM) importa tanto como este numero. El
# modelo en si siempre corre a 640x640 (ver MODEL_INFERENCE_SIZE en
# app/model.py), asi que subir esto solo mejora la nitidez de la imagen que
# ve el usuario, no cambia la resolucion de entrada del modelo.
MODEL_TILE_SIZE=960

DEFAULT_CONFIDENCE_THRESHOLD=0.90

PNOA_WMS_URL=https://www.ign.es/wms-inspire/pnoa-ma
PNOA_LAYER=OI.OrthoimageCoverage
