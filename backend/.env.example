BACKEND_PORT=4000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=centinela_cyl
POSTGRES_USER=centinela
POSTGRES_PASSWORD=change_me

MODEL_SERVICE_URL=http://localhost:8000

# Radio (en metros) por debajo del cual una deteccion se considera
# probablemente la propia instalacion legal (falso positivo) en vez de un
# vertedero ilegal junto a ella.
LEGAL_FACILITY_RADIUS_METERS=100

# Opcional. Si defines un valor aqui, los endpoints que ejecutan
# inferencia o escriben datos (analizar celda, subir imagen, reportar
# estadistica) exigiran la cabecera "X-App-Token" con este mismo valor -
# util solo cuando abres el backend a otros dispositivos de tu red (por
# ejemplo con VITE_BACKEND_URL apuntando a tu IP y host:true en Vite) y no
# quieres que cualquiera que pueda alcanzar esa IP ejecute analisis
# gratis. Si lo dejas vacio (por defecto), no se exige ningun token - el
# comportamiento de siempre para desarrollo en local.
# Pon el mismo valor en frontend/.env como VITE_ACCESS_TOKEN.
ACCESS_TOKEN=
